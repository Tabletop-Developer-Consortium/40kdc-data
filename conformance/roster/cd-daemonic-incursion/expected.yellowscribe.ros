              <characteristics>
                <characteristic name="Description">If the unit has the nurgle keyword, if the unit has the legiones-daemonica keyword, for the rest of the battle, friendly units within 6" gain the Shadow of Chaos ability.</characteristic>
              </characteristics>
            </profile>
            <profile name="Virulent Blessing (Psychic)" typeName="Abilities">
              <characteristics>
                <characteristic name="Description">During the Fight phase, until the end of the phase, add 1 to the unit's Damage characteristic.</characteristic>
              </characteristics>
            </profile>
            <profile name="Deep Strike" typeName="Abilities">
              <characteristics>
                <characteristic name="Description">The unit has the Deep Strike ability.</characteristic>
              </characteristics>
