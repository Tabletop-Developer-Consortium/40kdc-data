            </profile>
            <profile name="Invulnerable Save" typeName="Abilities">
              <characteristics>
                <characteristic name="Description">4+ invulnerable save</characteristic>
              </characteristics>
            </profile>
            <profile name="Deadly Demise D3" typeName="Abilities">
              <characteristics>
                <characteristic name="Description">Before this model is removed from play:
  -&gt; Roll one D6: on a 6+, each enemy unit within 6" suffers D3 mortal wounds.</characteristic>
              </characteristics>
            </profile>
            <profile name="Deep Strike" typeName="Abilities">
              <characteristics>
                <characteristic name="Description">The unit has the Deep Strike ability.</characteristic>
              </characteristics>
            </profile>
            <profile name="Surge of Wrath (Psychic)" typeName="Abilities">
              <characteristics>
                <characteristic name="Description">Against MONSTER targets or against VEHICLE targets:
  -&gt; You can re-roll the Hit roll for attacks made by this model with melee weapons.
  -&gt; You can re-roll the Wound roll for attacks made by this model with melee weapons.
  -&gt; You can re-roll the Damage roll for attacks made by this model with melee weapons.</characteristic>
              </characteristics>
            </profile>
            <profile name="Warrior Strategist" typeName="Abilities">
              <characteristics>
                <characteristic name="Description">When this model's unit is targeted with a Stratagem, you may use this ability, once per battle round per army, when resolving this use, reduce the CP cost of that use of the Stratagem by 1CP (to a minimum of 0CP), before paying its cost.</characteristic>
              </characteristics>
            </profile>
          </profiles>
