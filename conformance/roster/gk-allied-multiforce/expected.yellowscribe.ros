      <selections>
        <selection id="unit0" name="Grand Master in Nemesis Dreadknight" type="unit" number="1">
          <profiles>
            <profile name="Grand Master in Nemesis Dreadknight" typeName="Unit">
              <characteristics>
                <characteristic name="M">8"</characteristic>
                <characteristic name="T">8</characteristic>
                <characteristic name="SV">2+</characteristic>
                <characteristic name="W">13</characteristic>
                <characteristic name="LD">6+</characteristic>
                <characteristic name="OC">4</characteristic>
