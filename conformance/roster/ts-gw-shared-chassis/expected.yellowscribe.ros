        <selection id="unit0" name="Thousand Sons Rhino" type="unit" number="1">
          <profiles>
            <profile name="Chaos Rhino" typeName="Unit">
              <characteristics>
                <characteristic name="M">12"</characteristic>
                <characteristic name="T">9</characteristic>
                <characteristic name="SV">3+</characteristic>
                <characteristic name="W">10</characteristic>
                <characteristic name="LD">6+</characteristic>
                <characteristic name="OC">2</characteristic>
              </characteristics>
            </profile>
            <profile name="Assault Vehicle" typeName="Abilities">
              <characteristics>
                <characteristic name="Description">Units can disembark from this model after it has Advanced; such units count as having made a Normal move, but cannot declare a charge this turn.</characteristic>
              </characteristics>
            </profile>
            <profile name="Fire Support" typeName="Abilities">
              <characteristics>
                <characteristic name="Description">During the Shooting phase, until the end of the phase, you can re-roll the Wound roll.</characteristic>
              </characteristics>
            </profile>
            <profile name="Firing Deck 2" typeName="Abilities">
              <characteristics>
                <characteristic name="Description">The unit gains the Firing Deck ability (2).</characteristic>
              </characteristics>
            </profile>
            <profile name="Meet Any Challenge" typeName="Abilities">
              <characteristics>
                <characteristic name="Description">An enemy unit ends a move, you may use this ability, the unit can make a Reactive move.</characteristic>
              </characteristics>
            </profile>
            <profile name="Self Repair" typeName="Abilities">
              <characteristics>
                <characteristic name="Description">This model regains up to 1 lost wound.</characteristic>
              </characteristics>
            </profile>
            <profile name="Sorcerous Support" typeName="Abilities">
              <characteristics>
                <characteristic name="Description">During the Shooting phase, until the end of the phase:
  -&gt; The unit gets +1 to Hit rolls.
  -&gt; The unit gets +1 to Wound rolls.</characteristic>
              </characteristics>
            </profile>
            <profile name="Deadly Demise D3" typeName="Abilities">
              <characteristics>
                <characteristic name="Description">Before this model is removed from play:
  -&gt; Roll one D6: on a 6+, each enemy unit within 6" suffers D3 mortal wounds.</characteristic>
              </characteristics>
            </profile>
          </profiles>
