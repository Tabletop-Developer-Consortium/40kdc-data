            </profile>
            <profile name="Blood Surge" typeName="Abilities">
              <characteristics>
                <characteristic name="Description">When damage is allocated, you may use this ability, during the Shooting phase, in the opponent's turn, while the model has lost wounds, until the end of the phase, the unit can make a Reactive move of up to D6+2" (Blood Surge).</characteristic>
              </characteristics>
            </profile>
            <profile name="Icon of Khorne" typeName="Abilities">
              <characteristics>
                <characteristic name="Description">Each time an enemy unit is destroyed, you gain 1 Bloodshed Point.
Add one rolled D6 to your Blessings of Khorne Pool for each Bloodshed Point you have, after which all your Bloodshed Points are lost.</characteristic>
              </characteristics>
            </profile>
          </profiles>
