<?xml version="1.0" encoding="utf-8"?>
<roster id="roster0" name="Terminator Loadout Decomposition" gameSystemId="sys-352e-adc2-7639-d6a9" gameSystemName="Warhammer 40,000">
  <forces>
    <force id="force0" name="World Eaters" catalogueName="World Eaters">
      <selections>
        <selection id="unit0" name="Daemon Prince of Khorne" type="unit" number="1">
          <profiles>
            <profile name="Daemon Prince of Khorne" typeName="Unit">
              <characteristics>
                <characteristic name="M">10"</characteristic>
                <characteristic name="T">10</characteristic>
                <characteristic name="SV">2+</characteristic>
                <characteristic name="W">10</characteristic>
                <characteristic name="LD">6+</characteristic>
                <characteristic name="OC">3</characteristic>
              </characteristics>
            </profile>
            <profile name="Invulnerable Save" typeName="Abilities">
              <characteristics>
                <characteristic name="Description">4+ invulnerable save</characteristic>
              </characteristics>
            </profile>
            <profile name="Deadly Demise D3" typeName="Abilities">
              <characteristics>
                <characteristic name="Description">When a model in the unit is destroyed, until the end of the phase:
  -&gt; Roll one D6: on a 6+, each enemy unit within 6" suffers D3 mortal wounds.</characteristic>
              </characteristics>
            </profile>
            <profile name="Devastating Assault" typeName="Abilities">
              <characteristics>
                <characteristic name="Description">Before a Hit roll is made, if the unit charged this turn, until the end of the turn, this model's hellforged weapons gains [DEVASTATING WOUNDS].</characteristic>
              </characteristics>
            </profile>
            <profile name="Direct the Slaughter" typeName="Abilities">
              <characteristics>
                <characteristic name="Description">At the start of the phase, if within 12" of a friendly unit, until the end of the battle round, you can use one Stratagem on this model for 0CP.</characteristic>
              </characteristics>
            </profile>
            <profile name="Lord of Murder" typeName="Abilities">
              <characteristics>
                <characteristic name="Description">If within 3" of friendly infantry, this model gains the Lone Operative ability.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <categories>
            <category name="Faction: World Eaters"/>
            <category name="Monster"/>
            <category name="Character"/>
            <category name="Chaos"/>
            <category name="Khorne"/>
            <category name="Daemon"/>
            <category name="Daemon Prince"/>
          </categories>
          <selections>
            <selection id="unit0-m0" name="Daemon Prince of Khorne" type="model" number="1">
              <selections>
                <selection id="unit0-m0-w0" name="Infernal cannon" type="upgrade" number="1">
                  <profiles>
                    <profile name="Infernal cannon" typeName="Ranged Weapons">
                      <characteristics>
                        <characteristic name="Range">24"</characteristic>
                        <characteristic name="A">3</characteristic>
                        <characteristic name="BS">3+</characteristic>
                        <characteristic name="S">5</characteristic>
                        <characteristic name="AP">-1</characteristic>
                        <characteristic name="D">2</characteristic>
                        <characteristic name="Keywords">Rapid Fire 1</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selection>
                <selection id="unit0-m0-w1" name="Hellforged weapons" type="upgrade" number="1">
                  <profiles>
                    <profile name="Sweep" typeName="Melee Weapons">
                      <characteristics>
                        <characteristic name="Range">Melee</characteristic>
                        <characteristic name="A">16</characteristic>
                        <characteristic name="WS">2+</characteristic>
                        <characteristic name="S">6</characteristic>
                        <characteristic name="AP">-1</characteristic>
                        <characteristic name="D">1</characteristic>
                        <characteristic name="Keywords"></characteristic>
                      </characteristics>
                    </profile>
                    <profile name="Strike" typeName="Melee Weapons">
                      <characteristics>
                        <characteristic name="Range">Melee</characteristic>
                        <characteristic name="A">8</characteristic>
                        <characteristic name="WS">2+</characteristic>
                        <characteristic name="S">8</characteristic>
                        <characteristic name="AP">-2</characteristic>
                        <characteristic name="D">3</characteristic>
                        <characteristic name="Keywords"></characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selection>
