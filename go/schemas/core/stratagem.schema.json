{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://40kdc.dev/schemas/core/stratagem.schema.json",
  "title": "Stratagem",
  "description": "A CP-costed ability usable during specific game phases.",
  "type": "object",
  "properties": {
    "id": { "$ref": "../defs/common.schema.json#/$defs/entity-id" },
    "external_refs": {
      "$ref": "../defs/common.schema.json#/$defs/external-reference-list"
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 128 },
    "category": {
      "type": "string",
      "enum": ["core", "detachment"],
      "description": "Whether this is a universal core stratagem or tied to a specific detachment"
    },
    "type": {
      "type": "string",
      "enum": ["battle-tactic", "strategic-ploy", "epic-deed", "wargear"],
      "description": "GW-printed stratagem category from the card. Optional: 11e faction packs omit it for newly introduced detachments, and the category has no in-game effect; absent when the source does not state one."
    },
    "detachment_id": {
      "oneOf": [
        { "$ref": "../defs/common.schema.json#/$defs/entity-id" },
        { "type": "null" }
      ],
      "description": "Null for core stratagems"
    },
    "cp_cost": { "type": "integer", "minimum": 0, "maximum": 4 },
    "phases": { "$ref": "../defs/common.schema.json#/$defs/phase-list" },
    "player_turn": { "$ref": "../defs/common.schema.json#/$defs/player-turn" },
    "timing": {
      "type": "string",
      "enum": [
        "once-per-phase",
        "once-per-turn",
        "once-per-battle",
        "unlimited"
      ]
    },
    "target_restrictions": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "required_keywords": {
              "$ref": "../defs/common.schema.json#/$defs/keyword-list",
              "description": "AND set: the target must carry every keyword listed here."
            },
            "required_keywords_any": {
              "$ref": "../defs/common.schema.json#/$defs/keyword-list",
              "description": "OR set: the target must carry at least one keyword listed here. Use for rules that target a unit with one of several keywords (e.g. Crushing Impact's MONSTER/VEHICLE, Explosives' EXPLOSIVES/GRENADES). Mirrors the `army_keywords_any` OR-gate on allied-rule.schema.json."
            },
            "excluded_keywords": {
              "$ref": "../defs/common.schema.json#/$defs/keyword-list"
            },
            "notes": { "type": "string" }
          },
          "additionalProperties": false
        },
        { "type": "null" }
      ]
    },
    "ability_id": {
      "oneOf": [
        { "$ref": "../defs/common.schema.json#/$defs/entity-id" },
        { "type": "null" }
      ]
    },
    "game_version": { "$ref": "../defs/game-version-ref.schema.json" },
    "game_modes": {
      "$ref": "../defs/common.schema.json#/$defs/game-modes",
      "description": "Game modes this stratagem is legal or authored for; absent implies matched-play."
    }
  },
  "required": [
    "id",
    "name",
    "category",
    "cp_cost",
    "phases",
    "player_turn",
    "timing",
    "game_version"
  ],
  "additionalProperties": false
}
