{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://40kdc.dev/schemas/enrichment/ability-dsl/effect.schema.json",
  "title": "Ability Effect",
  "$defs": {
    "effect-node": {
      "oneOf": [
        { "$ref": "#/$defs/single-effect" },
        { "$ref": "#/$defs/choice-effect" },
        { "$ref": "#/$defs/sequence-effect" },
        { "$ref": "#/$defs/dice-gated-effect" },
        { "$ref": "#/$defs/conditional-effect" },
        { "$ref": "#/$defs/dice-pool-allocation-effect" },
        { "$ref": "#/$defs/select-units-effect" },
        { "$ref": "#/$defs/movement-modifier-effect" },
        { "$ref": "#/$defs/aura-effect" }
      ]
    },
    "scaling": {
      "type": "object",
      "description": "Scales the effect's numeric `modifier.value`: it applies once per `per` of `of` (rounding `round`, default down), optionally capped at `max_value`. E.g. '+2 to the Attacks characteristic for every 5 enemy models within 6\\\"' → modifier.value 2 with scaling { per: 5, of: 'enemy-models-in-range', within_inches: 6 }.",
      "properties": {
        "per": { "type": "integer", "minimum": 1 },
        "of": {
          "type": "string",
          "enum": ["enemy-models-in-range", "friendly-models-in-range", "models-in-bearer-unit", "enemy-units-in-range", "wounds-lost"]
        },
        "within_inches": { "type": "number" },
        "round": { "type": "string", "enum": ["down", "up"], "default": "down" },
        "max_value": { "type": "integer" }
      },
      "required": ["per", "of"],
      "additionalProperties": false
    },
    "single-effect": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "stat-modifier", "roll-modifier", "re-roll",
            "mortal-wounds", "feel-no-pain", "invulnerable-save", "ward",
            "keyword-grant", "unit-keyword", "deep-strike",
            "fallback-and-act", "fight-first", "fight-last",
            "shoot-on-death", "fight-on-death",
            "objective-control-modifier", "leadership-modifier",
            "damage-reduction", "attack-restriction",
            "ability-grant", "cp-gain", "cp-refund",
            "model-destruction", "resurrection",
            "resource-gain", "resource-spend",
            "charge-roll-modifier", "terrain-area-tag",
            "objective-tag", "unit-tag",
            "bs-modifier", "engagement-passthrough",
            "strategic-reserves-arrival", "remove-battle-shock",
            "unit-keyword-grant",
            "auto-result", "firing-deck", "disembark-after-move",
            "forgo-faction-rule"
          ]
        },
        "target": {
          "type": "string",
          "enum": [
            "self", "bearer", "unit", "attached-unit",
            "attacker", "defender", "target",
            "friendly-within-aura", "enemy-within-aura",
            "all-friendly", "all-enemy"
          ]
        },
        "modifier": { "type": "object", "additionalProperties": true },
        "scaling": { "$ref": "#/$defs/scaling" }
      },
      "required": ["type", "target"],
      "$comment": "Optional weapon narrowing on cruncher-interpreted modifiers (stat-modifier/roll-modifier/re-roll/keyword-grant): `weapon_type` ('melee'|'ranged'), `weapon_name` (one named weapon), or `weapon_keyword` (a weapon ability such as 'Torrent'|'Blast'|'Pistol' — restricts the effect to weapons carrying that keyword). When `type` is `re-roll`, `modifier` must carry `roll` (string) and `subset` (`ones` | `all-failures`). Rerolls always target failures; the subset decides whether only 1s are rerolled or every failed die. The constraint is enforced by AJV at validation time and stripped from the codegen bundle (typify can't model if/then/else) — the generated TS/Rust types therefore see `modifier` as an open object, matching its other-`type` callers. When `type` is `feel-no-pain`, `modifier` carries `threshold` (the FNP save target) and optionally `scope` ∈ {`all`, `mortal`}; an absent scope defaults to `all` (fires on every unsaved wound). The two scopes compose independently against the mortal-wound stream. Tag effects (`terrain-area-tag`, `objective-tag`, `unit-tag`) set a transient marker on the named subject; `modifier` carries `tag` (string) and optionally `source` ('this-action'|'destroying-unit') and `clears_on` ('turn-rollover'|'never'). `target` for tag effects names the kind of entity the tag is applied to ('unit', 'self') — a placeholder, since the marker target is the objective/terrain/unit specified by the action context, not a combat target. Parameterized weapon keywords on `keyword-grant`/`unit-keyword-grant`: a granted keyword may carry its rating either baked into the `keyword` string ('Sustained Hits 1') or structurally via `value` (Sustained Hits/Rapid Fire/Melta N); Anti-X keywords may use `anti_keyword` + `anti_threshold` (rendered '[ANTI-INFANTRY 4+]'). When `type` is `auto-result`, `modifier` carries `result` (`pass`|`fail`, or an integer the named roll counts as) plus `test` (e.g. 'battle-shock') or `roll` (e.g. 'hit'). When `type` is `firing-deck`, `modifier` carries `value` (the Firing Deck rating). `disembark-after-move` needs no modifier. When `type` is `forgo-faction-rule`, the controlling player skips activating a named faction rule (e.g. 'instead of activating any Blessings of Khorne'); `modifier` carries `rule` (the faction-rule slug forgone), optional `scope` (the window it is forgone for — e.g. 'battle-round'), and an optional `cost` object `{ dice, from }` describing the resource paid (e.g. a 'triple-6' taken `from` the 'blessings-of-khorne' roll).",
      "allOf": [
        {
          "if": {
            "properties": { "type": { "const": "re-roll" } },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "modifier": {
                "type": "object",
                "properties": {
                  "roll": { "type": "string", "minLength": 1 },
                  "subset": { "type": "string", "enum": ["ones", "all-failures"] }
                },
                "required": ["roll", "subset"]
              }
            },
            "required": ["modifier"]
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "auto-result" } },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "modifier": {
                "type": "object",
                "properties": {
                  "test": { "type": "string" },
                  "roll": { "type": "string" },
                  "result": {
                    "oneOf": [
                      { "type": "string", "enum": ["pass", "fail"] },
                      { "type": "integer" }
                    ]
                  }
                },
                "required": ["result"]
              }
            },
            "required": ["modifier"]
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "firing-deck" } },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "modifier": {
                "type": "object",
                "properties": { "value": { "type": "integer", "minimum": 1 } },
                "required": ["value"]
              }
            },
            "required": ["modifier"]
          }
        }
      ]
    },
    "choice-effect": {
      "type": "object",
      "properties": {
        "type": { "const": "choice" },
        "options": { "type": "array", "items": { "$ref": "#/$defs/effect-node" }, "minItems": 2 },
        "choice_label": { "type": "string" }
      },
      "required": ["type", "options"]
    },
    "sequence-effect": {
      "type": "object",
      "properties": {
        "type": { "const": "sequence" },
        "steps": { "type": "array", "items": { "$ref": "#/$defs/effect-node" }, "minItems": 1 }
      },
      "required": ["type", "steps"]
    },
    "dice-gated-effect": {
      "type": "object",
      "properties": {
        "type": { "const": "dice-gated" },
        "dice": { "type": "string", "description": "Dice expression, e.g. 'D6', '2D6'" },
        "threshold": {
          "oneOf": [
            { "type": "integer" },
            { "type": "string", "enum": ["leadership", "toughness", "save"] }
          ],
          "description": "Fixed threshold or model characteristic to compare against"
        },
        "comparison": {
          "type": "string",
          "enum": ["gte", "lte", "gt", "lt", "eq"],
          "default": "gte"
        },
        "on_success": {
          "oneOf": [
            { "$ref": "#/$defs/effect-node" },
            { "type": "null" }
          ]
        },
        "on_fail": {
          "oneOf": [
            { "$ref": "#/$defs/effect-node" },
            { "type": "null" }
          ]
        }
      },
      "required": ["type", "dice", "threshold"]
    },
    "conditional-effect": {
      "type": "object",
      "properties": {
        "type": { "const": "conditional" },
        "condition": { "$ref": "condition.schema.json" },
        "effect": { "$ref": "#/$defs/effect-node" }
      },
      "required": ["type", "condition", "effect"]
    },
    "dice-pool-allocation-effect": {
      "type": "object",
      "properties": {
        "type": { "const": "dice-pool-allocation" },
        "pool": {
          "type": "object",
          "properties": {
            "count": { "type": "integer", "minimum": 1 },
            "die": { "type": "string" }
          },
          "required": ["count", "die"]
        },
        "max_activations": { "type": "integer", "minimum": 1 },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "requirement": {
                "type": "object",
                "properties": {
                  "type": { "type": "string", "enum": ["pair", "triple", "single", "run"] },
                  "min_value": { "type": "integer", "minimum": 1, "maximum": 6 }
                },
                "required": ["type", "min_value"]
              },
              "effect": { "$ref": "#/$defs/effect-node" }
            },
            "required": ["name", "requirement", "effect"]
          },
          "minItems": 1
        }
      },
      "required": ["type", "pool", "max_activations", "options"]
    },
    "select-units-effect": {
      "type": "object",
      "$comment": "Targeting wrapper: choose up to `selector.max_count` units matching `selector.keywords` of the named `owner`, then apply the nested `effect` to each. Models 'select up to N <keyword> units and do X' (redeploy, army-wide one-off buffs) that bare ability-grant labels previously flattened.",
      "properties": {
        "type": { "const": "select-units" },
        "selector": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_count": { "type": "integer", "minimum": 1 },
            "keywords": { "type": "array", "items": { "type": "string" } },
            "owner": { "type": "string", "enum": ["friendly", "enemy"] }
          },
          "required": ["max_count", "owner"]
        },
        "effect": { "$ref": "#/$defs/effect-node" }
      },
      "required": ["type", "selector", "effect"]
    },
    "movement-modifier-effect": {
      "type": "object",
      "additionalProperties": false,
      "$comment": "Fully-closed movement-modifier (shape 1, Batch D). Promoted to its own discriminated effect-node branch so the closed `modifier` reaches the generated types (typify/json2ts can model a plain closed object, unlike if/then). `move_type` is the canonical move KIND and is OPTIONAL: a record may be a pure traversal CAPABILITY (passthrough/vertical_limit/ignore_vertical, applying to all moves or those in `applies_to_moves`) with no move_type. `distance` folds the old distance/value/bonus (integer or dice-expression string, e.g. 6, -2, \"D6+2\"). Reactivity lives at ability level (`trigger`), and frequency at ability level (`usage`) — neither is carried here. Non-movement mechanics that previously hid in this blob (deep-strike ranges, engagement passthrough, advance+charge eligibility, aura ranges) are re-homed to their own effect types.",
      "properties": {
        "type": { "const": "movement-modifier" },
        "target": {
          "type": "string",
          "enum": [
            "self", "bearer", "unit", "attached-unit",
            "attacker", "defender", "target",
            "friendly-within-aura", "enemy-within-aura",
            "all-friendly", "all-enemy"
          ]
        },
        "modifier": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "move_type": {
              "type": "string",
              "enum": [
                "normal", "advance", "pile-in", "consolidation", "reactive",
                "surge", "redeploy", "scout", "infiltrate", "shoot-and-scoot"
              ]
            },
            "distance": {
              "oneOf": [
                { "type": "integer" },
                { "type": "string", "minLength": 1 }
              ]
            },
            "passthrough": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "non-titanic-models", "friendly-vehicles", "friendly-monsters",
                  "terrain-le-4", "tall-terrain", "all-terrain"
                ]
              }
            },
            "vertical_limit": { "type": "integer", "minimum": 0 },
            "ignore_vertical": { "type": "boolean" },
            "replaces_default": { "type": "boolean" },
            "to_reserves": { "type": "boolean" },
            "applies_to_moves": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["normal", "advance", "fall-back", "charge"]
              }
            },
            "name": { "type": "string" },
            "excludes_keyword": { "type": "string" },
            "max_units": { "type": "integer", "minimum": 1 },
            "marker": {
              "type": "object",
              "additionalProperties": false,
              "$comment": "GSC marker / fortification placement mechanics (move_type: redeploy).",
              "properties": {
                "affected": { "type": "string" },
                "unit_filter": { "type": "string" },
                "location": { "type": "string" },
                "max_units": { "type": "integer", "minimum": 1 }
              }
            },
            "condition": { "$ref": "condition.schema.json" }
          }
        }
      },
      "required": ["type", "target", "modifier"]
    },
    "aura-effect": {
      "type": "object",
      "additionalProperties": false,
      "$comment": "Generic aura (Batch D): a persistent zone around a unit applying an effect to units within a range. Models Contagions, Shadow in the Warp, Vect — the concept the dataset previously expressed implicitly via `target: *-within-aura` + scope.range. `range` is the radius in inches (an integer, or an array of per-battle-round tiers, e.g. [3,6,9] for Contagions). `range_bonus` + `of` model an ability that EXTENDS a named aura's range (Gift of Poxes: contagion +3\"). `effect` is the nested effect applied within the zone. Batch D builds the type and migrates contagion-range; the ~300 incumbent within-aura-target effects are a separate follow-up sweep.",
      "properties": {
        "type": { "const": "aura" },
        "target": {
          "type": "string",
          "enum": ["enemy-within-aura", "friendly-within-aura"]
        },
        "modifier": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "range": {
              "oneOf": [
                { "type": "integer", "minimum": 1 },
                { "type": "array", "items": { "type": "integer", "minimum": 1 }, "minItems": 1 }
              ]
            },
            "range_bonus": { "type": "integer" },
            "of": { "type": "string" },
            "effect": { "$ref": "#/$defs/effect-node" }
          }
        }
      },
      "required": ["type", "target", "modifier"]
    }
  },
  "$ref": "#/$defs/effect-node"
}
