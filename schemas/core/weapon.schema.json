{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://40kdc.dev/schemas/core/weapon.schema.json",
  "title": "Weapon",
  "description": "A weapon entry with one or more stat profiles (e.g., standard and overcharge modes).",
  "type": "object",
  "properties": {
    "id": { "$ref": "../defs/common.schema.json#/$defs/entity-id" },
    "external_refs": {
      "$ref": "../defs/common.schema.json#/$defs/external-reference-list"
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 128 },
    "type": { "enum": ["ranged", "melee"] },
    "faction_id": {
      "$ref": "../defs/common.schema.json#/$defs/entity-id",
      "description": "Owning faction, stamped at bundle time from the weapon's data/core/<faction>/ directory. Enables faction-scoped resolution of a unit's weapon_ids so a bare weapon id shared across factions (e.g. 'close-combat-weapon') resolves to the wielder's own faction copy rather than whichever faction bundled first."
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 128 },
          "range": {
            "oneOf": [
              { "type": "integer", "minimum": 0 },
              { "type": "string", "const": "Melee" }
            ]
          },
          "stats": {
            "type": "object",
            "properties": {
              "A": { "$ref": "../defs/common.schema.json#/$defs/stat-value" },
              "BS": {
                "oneOf": [
                  { "type": "integer", "minimum": 2, "maximum": 6 },
                  { "type": "null" }
                ]
              },
              "WS": {
                "oneOf": [
                  { "type": "integer", "minimum": 2, "maximum": 6 },
                  { "type": "null" }
                ]
              },
              "S": { "$ref": "../defs/common.schema.json#/$defs/stat-value" },
              "AP": { "type": "integer" },
              "D": { "$ref": "../defs/common.schema.json#/$defs/stat-value" }
            },
            "required": ["A", "S", "AP", "D"]
          },
          "keywords": {
            "type": "array",
            "description": "References into the weapon-keyword catalog. Each entry names the catalog id and supplies parameter values (e.g. `Sustained Hits 1` → `{keyword_id: 'sustained-hits', parameters: {value: 1}}`).",
            "items": {
              "type": "object",
              "properties": {
                "keyword_id": {
                  "$ref": "../defs/common.schema.json#/$defs/entity-id"
                },
                "parameters": {
                  "type": "object",
                  "description": "Reference-site parameters conforming to the catalog entry's required parameters and optional target-keyword applicability gates.",
                  "properties": {
                    "value": {
                      "$ref": "../defs/common.schema.json#/$defs/stat-value"
                    },
                    "target_keyword": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64
                    },
                    "threshold": {
                      "type": "integer",
                      "minimum": 2,
                      "maximum": 6
                    },
                    "required_target_keywords_any": {
                      "$ref": "../defs/common.schema.json#/$defs/keyword-list",
                      "minItems": 1,
                      "description": "The keyword applies only when the target has at least one listed keyword."
                    },
                    "excluded_target_keywords": {
                      "$ref": "../defs/common.schema.json#/$defs/keyword-list",
                      "description": "The keyword does not apply when the target has any listed keyword."
                    }
                  },
                  "additionalProperties": false
                }
              },
              "required": ["keyword_id"],
              "additionalProperties": false
            }
          },
          "target_restrictions": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "required_keywords_any": {
                    "$ref": "../defs/common.schema.json#/$defs/keyword-list",
                    "minItems": 1,
                    "description": "The profile can target a unit carrying at least one listed keyword."
                  },
                  "excluded_keywords": {
                    "$ref": "../defs/common.schema.json#/$defs/keyword-list",
                    "description": "The profile cannot target a unit carrying any listed keyword."
                  }
                },
                "additionalProperties": false
              },
              { "type": "null" }
            ],
            "description": "Target legality for this profile. Distinct from Anti and other effects that modify attacks after a legal target is selected."
          }
        },
        "required": ["name", "stats"],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "game_version": { "$ref": "../defs/game-version-ref.schema.json" },
    "game_modes": {
      "$ref": "../defs/common.schema.json#/$defs/game-modes",
      "description": "Game modes this weapon is legal or authored for; absent implies matched-play."
    }
  },
  "required": ["id", "name", "type", "profiles", "game_version"],
  "additionalProperties": false
}
