{
  "title": "EvidencePacket",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_hash",
    "source_utf16_len",
    "clauses"
  ],
  "properties": {
    "source_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_utf16_len": {
      "type": "integer",
      "minimum": 1
    },
    "clauses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "start_utf16",
          "end_utf16",
          "classification",
          "slice_hash"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "start_utf16": {
            "type": "integer",
            "minimum": 0
          },
          "end_utf16": {
            "type": "integer",
            "minimum": 1
          },
          "classification": {
            "enum": [
              "mechanical",
              "nonmechanical"
            ]
          },
          "slice_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
