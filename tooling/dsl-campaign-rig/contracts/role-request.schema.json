{
  "title": "RoleRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "campaign_id",
    "faction_id",
    "ability_id",
    "role",
    "attempt",
    "manifest_hash",
    "input_artifacts"
  ],
  "properties": {
    "campaign_id": {
      "$ref": "#/$defs/id"
    },
    "faction_id": {
      "$ref": "#/$defs/id"
    },
    "ability_id": {
      "$ref": "#/$defs/id"
    },
    "role": {
      "type": "string"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "voter": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "manifest_hash": {
      "$ref": "#/$defs/hash"
    },
    "input_artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/hash"
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
