{
  "title": "Verification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_hash",
    "commit_id",
    "gates",
    "lever_verdict"
  ],
  "properties": {
    "candidate_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "commit_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{40,64}$"
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "status"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "enum": [
              "pass",
              "fail"
            ]
          }
        }
      }
    },
    "lever_verdict": {
      "enum": [
        "clean",
        "regression"
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
